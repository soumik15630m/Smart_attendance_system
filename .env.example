# Server
# postgresql+asyncpg://user:pass@host:port/db
DATABASE_URL=postgresql+asyncpg://neondb_owner:***********@ep-restless-***.aws.neon.tech/neondb

# Cache mode: auto | upstash_rest | redis
CACHE_BACKEND=auto

# Redis target
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Auto-start local Redis if unavailable
AUTO_START_LOCAL_REDIS=true
# Optional override command
# LOCAL_REDIS_START_CMD=redis-server --port 6379 --save "" --appendonly no
LOCAL_REDIS_START_CMD=
LOCAL_REDIS_START_TIMEOUT_SECONDS=12
PREFER_DOCKER_REDIS=true

# Upstash REST (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Security
SECRET_KEY=change-this-to-a-secure-random-string
API_KEY=my-secret-admin-key-2026
# Comma-separated list of origins allowed to call the API from a browser.
# Only used when DEBUG=False (DEBUG=True falls back to allowing all origins).
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# App
DEBUG=True
HOST=127.0.0.1
PORT=8000
LOCAL_ONLY=True
# 0.5 is standard for InsightFace. Lower = looser matching, Higher = stricter.
SIMILARITY_THRESHOLD=0.5
TZ=Asia/Kolkata

# Camera client
SERVER_IP=127.0.0.1
SERVER_PORT=8000
CAMERA_INDEX=0

# Face recognition model pack. MUST be identical between camera_client.py
# (live recognition) and register_face.py (enrollment) - mismatched models
# produce embeddings that cannot be meaningfully compared. Leave unset to
# auto-pick (buffalo_l on GPU, buffalo_s on CPU-only); set explicitly to
# override for both scripts.
# FACE_MODEL_NAME=buffalo_l

# Face tracking / recognition tuning (camera_client.py). All optional -
# sane defaults are computed at runtime from measured fps and frame size.
# MIN_BRIGHTNESS=60
# MIN_DET_SCORE=0.65
# IOU_MATCH_THRESHOLD=0.3
# TRACK_TIMEOUT_SECONDS=1.0
# BBOX_SMOOTHING_ALPHA=0.35
# STABILITY_SECONDS=0.18
# MOVEMENT_TOLERANCE_RATIO=0.10
# MIN_FACE_WIDTH_RATIO=0.06
# BLUR_FLOOR=25.0
# BLUR_STD_MARGIN=0.5
# BLUR_WARMUP_SAMPLES=20
# RETRY_BASE_SECONDS=1.5
# RETRY_MAX_SECONDS=10.0

# Registration tuning (register_face.py)
# MIN_SAMPLES=3
# MAX_SAMPLES=8
# CONVERGENCE_COSINE=0.999
# BLUR_RELATIVE_FRACTION=0.5

# Optional: Override CUDA path if it's not in your system PATH
# Optional CUDA bin path
# CUDA_PATH_BIN=C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v12.8\bin
